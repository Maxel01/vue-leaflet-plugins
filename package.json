{
  "name": "@maxel01/vue-leaflet-plugins",
  "version": "0.0.6",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/plugins.cjs",
  "module": "dist/plugins.js",
  "types": "./dist/plugins.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js",
      "require": "./dist/plugins.cjs"
    },
    "./dist/vue-leaflet-plugins.css": "./dist/vue-leaflet-plugins.css",
    "./style.css": "./dist/vue-leaflet-plugins.css"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "LICENCES/"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:maxel01/vue-leaflet-plugins.git"
  },
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "dev:vue": "pnpm --filter playground-vue dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --coverage",
    "build": "vue-tsc --noEmit && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint ./src --fix",
    "lint:check": "eslint ./src --max-warnings=0",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "docs:generate": "node docs/scripts/generate-docs.js",
    "docs:dev": "node docs/scripts/generate-docs.js && vitepress dev docs",
    "docs:build": "node docs/scripts/generate-docs.js && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "release-it"
  },
  "peerDependencies": {
    "@maxel01/vue-leaflet": "^1.0.0-beta.9",
    "leaflet": "^2.0.0-beta.1",
    "leaflet.heat": "^1.0.0",
    "leaflet.markercluster": "^2.0.0-beta.1",
    "simpleheat": "^1.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "leaflet.heat": {
      "optional": true
    },
    "leaflet.markercluster": {
      "optional": true
    },
    "simpleheat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@maxel01/vue-leaflet": "^1.0.0-beta.10",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/simpleheat": "^0.4.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "jsdom": "^30.1.3",
    "leaflet.heat": "^1.0.0",
    "leaflet.markercluster": "^2.0.0-beta.1",
    "prettier": "^3.9.10",
    "release-it": "^21.1.2",
    "simpleheat": "^1.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.5",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "^4.1.11",
    "vue": "^3.5.44",
    "vue-docgen-api": "^4.79.2",
    "vue-tsc": "^3.3.14"
  }
}
